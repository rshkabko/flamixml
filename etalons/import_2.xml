<?xml version="1.0" encoding="UTF-8"?>
<flamixml_commerce version="1.0">
  <offers>
    <!-- This page repeats the previous one (broken pagination of a plugin): everything is skipped as a duplicate -->
    <!-- Everything an offer can hold: two categories, prices in two currencies, stock by warehouse, multiple, number and list params, a picture by file name -->
    <offer external_id="example-flamixml-product-1">
      <name>Example product 1</name>
      <sku>EXAMPLE-FLAMIXML-1</sku>
      <active>true</active>
      <description>&lt;p&gt;Example &lt;b&gt;HTML&lt;/b&gt; description&lt;/p&gt;</description>
      <categories>
        <category external_id="example-flamixml-category-1"/>
        <category external_id="example-flamixml-category-2"/>
      </categories>
      <pictures>
        <picture>example-product-1.webp</picture>
      </pictures>
      <prices>
        <price external_id="BASE" value="100.00" currency="UAH"/>
        <price external_id="SALE" value="2.00" currency="USD"/>
      </prices>
      <stocks>
        <stock external_id="example-flamixml-warehouse" value="5"/>
      </stocks>
      <params>
        <param external_id="example-flamixml-tags">
          <values>
            <value>new</value>
            <value>sale</value>
          </values>
        </param>
        <param external_id="example-flamixml-length">
          <values>
            <value>12.5</value>
          </values>
        </param>
        <param external_id="example-flamixml-size">
          <values>
            <value external_id="example-flamixml-size-m">M</value>
          </values>
        </param>
      </params>
    </offer>
    <!-- Deactivated product, total stock without a warehouse -->
    <offer external_id="example-flamixml-product-2">
      <name>Example product 2</name>
      <active>false</active>
      <categories>
        <category external_id="example-flamixml-category-2"/>
      </categories>
      <pictures>
        <picture>example-product-2.webp</picture>
      </pictures>
      <prices>
        <price external_id="BASE" value="50.00" currency="USD"/>
      </prices>
      <stocks>
        <stock value="0"/>
      </stocks>
    </offer>
    <!-- Variant: states all its own fields -->
    <offer external_id="example-flamixml-variant-1" parent_external_id="example-flamixml-product-1">
      <name>Example product 1 - Variant</name>
      <active>true</active>
      <categories>
        <category external_id="example-flamixml-category-2"/>
      </categories>
      <prices>
        <price external_id="BASE" value="90.00" currency="UAH"/>
      </prices>
    </offer>
    <!-- Skipped: no external_id -->
    <offer>
      <name>Example without id</name>
    </offer>
  </offers>
</flamixml_commerce>
